# Godot 4+ specific ignores
.godot/
/android/

# Temporary Blender caches & backups
*.blend1
scenes/ui/*.tscn.backup

# Lightmap EXR textures (too large for Git, regenerated by baking)
*.exr
*.exr.import

# Source/working files & caches
_source/
_unused/
*.unwrap_cache

# GodotSteam pre-compiled editor (173MB, not for git)
tools/godotsteam-editor/*.exe
tools/godotsteam-editor/*.dll
tools/godotsteam-editor/steam_appid.txt

# GodotSteam export templates (~210MB each, not for git)
tools/godotsteam-templates/

# Exported game builds (not for git)
export/
